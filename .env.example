# Copy to backend/.env (never commit the real file). Keys are only ever read from the environment; they are never logged.
#
# After adding a key, run once:   cd backend && uv run python ../scripts/llm_smoke.py
# It makes a few tiny real calls and prints PASS/FAIL for each capability Studio relies on.

# ---- who writes the policy ----------------------------------------------------------------------------------------
# fake   = offline and deterministic (default). It copies the nearest example: NOT a translation. Studio says so.
# gemini = Google Gemini      claude = Anthropic Claude
LLM_PROVIDER=fake

# ---- who embeds text for retrieval (RAG) ---------------------------------------------------------------------------
# Defaults to the same provider, or to gemini when LLM_PROVIDER=claude (Claude has no embeddings endpoint).
# EMBED_PROVIDER=gemini

# ---- Gemini ---------------------------------------------------------------------------------------------------------
GEMINI_API_KEY=
# Model ids are retired over time (gemini-2.0-flash and gemini-2.5-flash are gone or going). Check the Gemini docs.
GEMINI_MODEL=gemini-3.6-flash              # gemini-3.5-flash-lite is the cheaper stable option
GEMINI_EMBED_MODEL=gemini-embedding-2      # gemini-embedding-001 also works (uses a taskType field instead)
# Be gentle with the free tier: requests per minute we allow ourselves (0 = no client-side limit).
GEMINI_RPM=10
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_EMBED_DIMS=768
GEMINI_TIMEOUT=60

# ---- Claude ---------------------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5               # claude-sonnet-5-5 costs less
CLAUDE_EFFORT=medium                       # low | medium | high | xhigh | max
CLAUDE_MAX_TOKENS=16000
# Optional refusal fallback (documented server-side beta). Off unless set; confirm with scripts/llm_smoke.py.
# CLAUDE_FALLBACK_MODEL=

# ---- caching (sqlite file under backend/data) -------------------------------------------------------------------------
LLM_CACHE_EMBED=1                          # embeddings are deterministic: always safe to cache
LLM_CACHE_GENERATE=0                       # 1 = reuse identical prompts (benchmarks turn this on for reproducibility)
# LLM_CACHE_PATH=
